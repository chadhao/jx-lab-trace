    "ALL": "全（新增 / 修改 / 停用）",
    "READ": "只读",
    "INIT": "仅发起",
    "APPROVE": "仅审批 / 确认",
    "NONE": "无"
  },

  "roles": [
    { "code": "receiver", "name": "收货员", "kind": "business", "is_system": true, "note": "含库管 / 门岗" },
    { "code": "qc", "name": "质检员", "kind": "business", "is_system": true, "note": "质检技术部 / 化验室" },
    { "code": "production", "name": "生产班组", "kind": "business", "is_system": true },
