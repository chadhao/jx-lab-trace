# .env.deploy.example —— 部署到测试服务器的运行配置**模板**
#
# 用法：cp .env.deploy.example .env.deploy 然后填真值。
# ★★ `.env.deploy` 已被 .gitignore 覆盖，**绝不进版本库**（含明文口令）。
# ★★ 服务只在测试服务器（192.168.10.50）上跑；本机只编译、不运行。见 docs/05-环境与调试约定.md。

# 数据库（服务器上已有的容器 jx-lab-trace-mysql，绑 192.168.10.50:3306）
JX_DB_DSN=jx_lab:<APP_PASSWORD>@tcp(192.168.10.50:3306)/jx_lab_trace?charset=utf8mb4&parseTime=true&loc=Local

# ★ 只绑回环；对外由 Caddy 反代。端口 18080 是既定约定（避开 5000/5001/8080/8088/4399/9000/9001/3000）
JX_HTTP_ADDR=127.0.0.1:18080

# 开发期免登（真实飞书应用凭据待用户提供，见 REMAINING.md#U1）
JX_DEV_MODE=true
JX_DEV_OPEN_ID=ou_dev_admin
JX_BOOTSTRAP_SYS_ADMIN_OPEN_ID=ou_dev_admin

# 会话
JX_SESSION_TTL=12h

# 附件（开发期在部署目录下；生产期迁到 /srv/jx-lab-trace/attachments）
JX_ATTACH_DIR=/home/chadhao/jx-lab-trace/attachments
